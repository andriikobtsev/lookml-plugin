<idea-plugin url="https://andriikobtsev.github.io/lookml-plugin/">
    <id>com.andriidev.lookml</id>
    <name>LookML Support</name>
    <vendor email="andrii.kobtsev@gmail.com" url="https://github.com/andriikobtsev/lookml-plugin">Andrii Kobtsev</vendor>

    <!-- release-date/release-version = the MAJOR release only. Minor updates (2026.2.1, 2026.2.2, ...)
         must keep BOTH unchanged: altering them marks a new stable version and resets active trials. -->
    <!-- optional="true" = freemium: plugin loads without a license; only Pro features are gated. -->
    <product-descriptor code="PLOOKMLSUPPORT" release-date="20260717" release-version="20262" optional="true"/>

    <!-- Compatible with PyCharm and other IntelliJ-based IDEs -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="com.andriidev.lookml.license" displayType="STICKY_BALLOON" isLogByDefault="true"/>

        <!-- File Type -->
        <fileType 
            name="LookML" 
            implementationClass="com.yourcompany.lookml.LookMLFileType"
            language="LookML" 
            extensions="lkml;lookml"/>
        
        <!-- Language -->
        <lang.parserDefinition 
            language="LookML"
            implementationClass="com.yourcompany.lookml.LookMLParserDefinition"/>
        
        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory 
            language="LookML"
            implementationClass="com.yourcompany.lookml.highlighting.LookMLSyntaxHighlighterFactory"/>
        
        <!-- Color Settings Page -->
        <colorSettingsPage 
            implementation="com.yourcompany.lookml.highlighting.LookMLColorSettingsPage"/>
        
        <!-- Commenter -->
        <lang.commenter 
            language="LookML"
            implementationClass="com.yourcompany.lookml.LookMLCommenter"/>
        
        <!-- Brace Matcher -->
        <lang.braceMatcher 
            language="LookML"
            implementationClass="com.yourcompany.lookml.LookMLBraceMatcher"/>
        
        <!-- Quote Handler -->
        <lang.quoteHandler 
            language="LookML"
            implementationClass="com.yourcompany.lookml.LookMLQuoteHandler"/>
        
        <!-- Completion -->
        <completion.contributor 
            language="LookML"
            implementationClass="com.yourcompany.lookml.completion.LookMLCompletionContributor"/>

        <!-- Go to Definition (Track A) -->
        <gotoDeclarationHandler
            implementation="com.yourcompany.lookml.references.LookMLGotoDeclarationHandler"/>

        <!-- Find Usages (Track A reference layer) -->
        <lang.findUsagesProvider
            language="LookML"
            implementationClass="com.yourcompany.lookml.references.LookMLFindUsagesProvider"/>

        <!-- Extends / extended-by gutter markers (Track A) -->
        <codeInsight.lineMarkerProvider
            language="LookML"
            implementationClass="com.yourcompany.lookml.references.LookMLViewLineMarkerProvider"/>

        <!-- Go to Implementation(s) (Ctrl/Cmd+Alt+B): base view -> extenders/refinements (Track A / E) -->
        <definitionsSearch
            implementation="com.yourcompany.lookml.references.LookMLImplementationsSearch"/>

        <!-- Go to Super (Ctrl/Cmd+U): view -> the base view(s) it extends/refines (Track A / E) -->
        <codeInsight.gotoSuper
            language="LookML"
            implementationClass="com.yourcompany.lookml.references.LookMLGotoSuperHandler"/>
        
        <!-- Code Folding -->
        <lang.foldingBuilder
            language="LookML"
            implementationClass="com.yourcompany.lookml.formatting.LookMLFoldingBuilder"/>

        <!-- Code Formatting -->
        <lang.formatter
            language="LookML"
            implementationClass="com.yourcompany.lookml.formatting.LookMLFormattingModelBuilderV2"/>

        <!-- Code Style Settings -->
        <langCodeStyleSettingsProvider
            implementation="com.yourcompany.lookml.formatting.LookMLLanguageCodeStyleSettingsProvider"/>

        <annotator
            language="LookML"
            implementationClass="com.yourcompany.lookml.yaml.YamlDashboardAnnotator"/>
    </extensions>

    <projectListeners>
        <!-- Notices are driven by opening a LookML file, not by opening a project. -->
        <listener class="com.yourcompany.lookml.license.LookMLFileOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="LookML.ReformatYamlDashboard"
                class="com.yourcompany.lookml.actions.ReformatYamlDashboardAction"
                text="Reformat YAML Dashboard"
                description="Reformat YAML dashboard with correct indentation">
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift Y"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift Y"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift Y"/>
        </action>
        
        <action id="LookML.FormatCode"
                class="com.yourcompany.lookml.formatting.LookMLFormatAction"
                text="Format LookML Code"
                description="Format LookML code with proper indentation">
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift L"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift L"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift L"/>
        </action>
    </actions>
</idea-plugin>
